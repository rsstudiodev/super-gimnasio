---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/index/Hero.astro';
import Services from '../components/index/Services.astro';
import Schedule from '../components/index/Schedule.astro';
import Gallery from '../components/index/Gallery.astro';
import InstagramFeed from '../components/index/InstagramFeed.astro';
import Trainers from '../components/index/Trainers.astro';
import Pricing from '../components/index/Pricing.astro';
import Reviews from '../components/index/Reviews.jsx';
import Location from '../components/index/Location.jsx';
import MapCard from '../components/index/MapCard.astro';
import SectionHeading from '../components/common/SectionHeading.jsx';
import { fotoHero } from '../content/fotos';
import { sitio } from '../content/sitio';

const seo = {
  title: `${sitio.nombre} · ${sitio.ciudad}`,
  description:
    'Escuela de box en Jalisco para principiantes, niños y quien quiera ponerse en forma. Clases de box, niños y acondicionamiento.',
};
---

<Layout seo={seo}>
  <main>
    <Hero
      foto={fotoHero}
      variant="home"
      badge="Primera clase gratis"
      titulo="Aquí nadie<br>empieza sabiendo"
      texto="Escuela de box en Jalisco para principiantes, niños y quien quiera ponerse en forma. Entrenamos técnica, condición y respeto — a tu ritmo, con guantes prestados el primer día."
      cifras={[
        { valor: '7', etiqueta: 'Días a la semana' },
        { valor: '12', etiqueta: 'Máx. por grupo' },
        { valor: '6+', etiqueta: 'Años de edad' },
      ]}
    />
    <Services />
    <Schedule />
    <Gallery />
    <InstagramFeed />
    <Trainers />
    <Pricing />
    <Reviews client:only="react" />
    <section id="ubicacion" class="flex w-full scroll-mt-24 flex-col items-center px-5 py-20 md:px-6">
      <SectionHeading title="Dónde estamos" subtitle="Dirección ficticia de demostración." />
      <Location client:load />
      <MapCard />
    </section>
  </main>
</Layout>
