---
import SectionHeading from '../common/SectionHeading.jsx';
import ImageCard from '../common/ImageCard.jsx';
import { galeriaPortada } from '../../content/fotos';
---

<section id="galeria" class="flex w-full scroll-mt-24 flex-col items-center px-5 py-20 md:px-6">
  <SectionHeading
    title="El gimnasio"
    subtitle="Costales, ring, y gente que ayer tampoco sabía tirar un jab."
  />
  <div class="grid w-full max-w-6xl grid-cols-2 gap-5 md:grid-cols-3">
    {galeriaPortada.map((f) => (
      <ImageCard src={f.url} alt={f.alt} />
    ))}
  </div>
</section>
