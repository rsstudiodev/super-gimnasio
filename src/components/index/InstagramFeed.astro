---
import SectionHeading from '../common/SectionHeading.jsx';
import { publicacionesInstagram } from '../../content/instagram';
import { sitio } from '../../content/sitio';
import InstagramIcon from '../../assets/external/instagram.svg?raw';
---

<section id="instagram" class="flex w-full scroll-mt-24 flex-col items-center px-5 py-20 md:px-6">
  <SectionHeading
    title="Síguenos el paso"
    subtitle="Feed de Instagram incrustado — contenido de demostración."
  />
  <div class="w-full max-w-5xl overflow-hidden rounded-2xl border border-brand-accent/14 bg-brand-surface md:rounded-3xl">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-brand-light/8 px-6.5 py-5.5">
      <div class="flex items-center gap-4">
        <span class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-brand-accent font-label text-lg font-extrabold text-brand-accent">
          {sitio.marcaIniciales}
        </span>
        <span class="flex flex-col gap-1">
          <span class="flex items-center gap-2 font-label text-lg font-bold text-brand-light [&_svg]:h-4.5 [&_svg]:w-4.5 [&_svg]:fill-brand-accent" set:html={`${InstagramIcon}${sitio.instagram.usuario}`} />
          <span class="flex gap-4.5 text-[13px] font-light text-brand-light/55">
            <span>{sitio.instagram.publicaciones}</span>
            <span>{sitio.instagram.seguidores}</span>
          </span>
        </span>
      </div>
      <a
        href={sitio.redes.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-brand-accent px-6 py-3.25 font-label text-[13px] font-bold uppercase tracking-[0.12em] text-brand-dark transition-all duration-300 hover:bg-brand-accent/80"
      >
        Seguir
      </a>
    </div>
    <div class="grid grid-cols-3 gap-[2px] bg-brand-light/8">
      {publicacionesInstagram.map((p) => (
        <a href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer" class="group relative block aspect-square overflow-hidden bg-brand-surface">
          <img
            src={p.url}
            alt={p.alt}
            loading="lazy"
            class="h-full w-full object-cover saturate-60 brightness-85 transition-all duration-400 group-hover:scale-106 group-hover:saturate-80 group-hover:brightness-100"
          />
        </a>
      ))}
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-brand-light/8 px-6.5 py-5">
      <span class="text-[13px] font-light text-brand-light/50">Últimas 6 publicaciones · se actualiza solo</span>
      <a
        href={sitio.redes.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label text-[13px] font-semibold uppercase tracking-[0.12em] text-brand-accent hover:text-brand-accent/80"
      >
        Ver el perfil completo →
      </a>
    </div>
  </div>
</section>
